<Window x:Class="ArabicPdfOcrApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:ArabicPdfOcrApp.ViewModels"
        xmlns:converters="clr-namespace:ArabicPdfOcrApp.Converters"
        xmlns:models="clr-namespace:ArabicPdfOcrApp.Models"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Arabic PDF Text Extractor (OCR) - .NET 10"
        Icon="Assets/app_icon.png"
        Height="850" Width="1350"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <converters:NullToVisibilityConverter x:Key="InvertedNullToVisConverter" Invert="True" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header Controls Card -->
            <RowDefinition Height="*" />     <!-- Side-by-Side Main Content -->
            <RowDefinition Height="Auto" />  <!-- Progress Footer -->
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR / FILE SELECTION CARD -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10"
                CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ROW 0: Single compact toolbar row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- App title -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="20" />
                        <!-- Source PDF (fills remaining) -->
                        <ColumnDefinition Width="*" />
                        <!-- Gap -->
                        <ColumnDefinition Width="10" />
                        <!-- Output path -->
                        <ColumnDefinition Width="*" />
                        <!-- Gap -->
                        <ColumnDefinition Width="16" />
                        <!-- OCR engine -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Gap -->
                        <ColumnDefinition Width="8" />
                        <!-- Theme toggle -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App title icon + name -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA90;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Arabic PDF OCR" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text=".NET 10 · Tesseract 5.2" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="30,2,0,0"/>
                    </StackPanel>

                    <!-- Source PDF: textbox + Browse button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Source PDF:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PdfFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7,5" IsReadOnly="True" VerticalAlignment="Center"
                                     FontSize="12"/>
                            <Button Grid.Column="1"
                                    Command="{Binding OpenFileCommand}"
                                    Margin="6,0,0,0" Padding="14,6"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Output path: textbox + Change button -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Output (.txt):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7,5" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseOutputPathCommand}"
                                    Margin="6,0,0,0" Padding="10,6">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- OCR Engine ComboBox -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock Text="OCR Engine:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableEngines}"
                                  SelectedItem="{Binding SelectedOcrEngine}"
                                  Width="190" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Theme Toggle -->
                    <Button Grid.Column="8" VerticalAlignment="Bottom"
                            Command="{Binding ToggleThemeCommand}"
                            Padding="10,6" ToolTip="Toggle Dark/Light Theme">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ROW 1: Extract action bar (slim) -->
                <Border Grid.Row="1" Margin="0,10,0,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   Text="Load a PDF, then click Extract to run Arabic OCR page-by-page."/>
                        <Button Grid.Column="1"
                                Command="{Binding StartOcrCommand}"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Height="34" Padding="20,0" FontSize="13" FontWeight="Bold"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="EXTRACT ARABIC TEXT (OCR)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA: SIDE-BY-SIDE SPLIT VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: PDF PREVIEW WINDOW -->
            <Border Grid.Column="0" Padding="14" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left Panel Header & Page Navigation Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="PDF Page Preview" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Page Nav Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasLoadedPdf, Converter={StaticResource NullToVisConverter}}">
                            <Button Command="{Binding SelectPreviousPageCommand}" 
                                    ToolTip="Previous Page" 
                                    Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                            
                            <TextBlock VerticalAlignment="Center" Margin="6,0" FontSize="13">
                                <Run Text="Page " />
                                <Run Text="{Binding SelectedPageIndex}" FontWeight="Bold" />
                                <Run Text=" of " />
                                <Run Text="{Binding TotalPages}" />
                            </TextBlock>

                            <Button Command="{Binding SelectNextPageCommand}" 
                                    ToolTip="Next Page" 
                                    Padding="8,4" Margin="4,0,0,0">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- PDF Viewer Display Area -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="6" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                        <Grid>
                            <!-- Empty / Drop Prompt -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasLoadedPdf, Converter={StaticResource InvertedNullToVisConverter}}">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Drag &amp; Drop a PDF file here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="or click Browse PDF to select a document" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Loaded Page Image Preview -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasLoadedPdf, Converter={StaticResource NullToVisConverter}}">
                                <Image Source="{Binding SelectedPage.PageImage}" 
                                       Stretch="Uniform" 
                                       Margin="12" 
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Page Thumbnail Bar at Bottom of Left Panel -->
                    <ListBox Grid.Row="2" 
                             ItemsSource="{Binding Pages}" 
                             SelectedItem="{Binding SelectedPage}"
                             Margin="0,10,0,0" Height="74"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasLoadedPdf, Converter={StaticResource NullToVisConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PdfPageItem}">
                                <Border BorderThickness="2" 
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                                        CornerRadius="4" Margin="2" Padding="2" Width="52" Height="60">
                                    <Grid>
                                        <Image Source="{Binding PageImage}" Stretch="Uniform"/>
                                        <Border Background="#CC000000" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding PageIndex}" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT PANEL: ARABIC TEXT PREVIEW (RTL) -->
            <Border Grid.Column="2" Padding="14" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Right Panel Header & 3-Step Pipeline Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Panel Title -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Extracted Arabic Text (معاينة النص العربي)" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CopyToClipboardCommand}" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy Text" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: 3-Step Pipeline Toolbar -->
                        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Step 1: PDF -> TXT -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,6,0">
                                        <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding StartOcrCommand}" 
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                            Padding="10,4" FontWeight="SemiBold" Margin="0,0,4,0"
                                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PDF → TXT" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveTextCommand}" Padding="8,4" ToolTip="Save as TXT">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                    </Button>
                                </StackPanel>

                                <!-- Separator Arrow 1 -->
                                <TextBlock Grid.Column="1" Text="➔" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="6,0"/>

                                <!-- Step 2: TXT -> EPUB -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#7C3AED" CornerRadius="10" Width="20" Height="20" Margin="0,0,6,0">
                                        <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding SaveAsEpubCommand}" 
                                            Padding="10,4"
                                            Background="#7C3AED"
                                            Foreground="White" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="TXT → EPUB" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Separator Arrow 2 -->
                                <TextBlock Grid.Column="3" Text="➔" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="6,0"/>

                                <!-- Step 3: EPUB -> KFX -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#B45309" CornerRadius="10" Width="20" Height="20" Margin="0,0,6,0">
                                        <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding SaveAsKfxCommand}" 
                                            Padding="10,4"
                                            Background="#B45309"
                                            Foreground="White" FontWeight="SemiBold"
                                            ToolTip="Requires Calibre + KFX Output plugin">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE97B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="EPUB → KFX" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Text Preview Area with Dynamic Center Button if Text is Empty -->
                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding ExtractedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FlowDirection="RightToLeft" 
                                 TextAlignment="Right" 
                                 FontFamily="Segoe UI, Arial, Tahoma, Traditional Arabic" 
                                 FontSize="17" 
                                 Padding="12"
                                 AcceptsReturn="True" 
                                 AcceptsTab="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"/>

                        <!-- Overlay Extract Button when PDF is loaded but no text is extracted yet -->
                        <Border Background="#D8000000" CornerRadius="8" Margin="20"
                                Visibility="{Binding ExtractedText, Converter={StaticResource InvertedNullToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="44" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Ready to Process PDF Document" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click the button below to perform Arabic OCR extraction" FontSize="13" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                                
                                <Button Command="{Binding StartOcrCommand}" 
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                        Height="42" Padding="28,0" FontSize="16" FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Start Arabic OCR Extraction" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Metrics Footer -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalWordCount}" FontWeight="Bold" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Words" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <TextBlock Text="{Binding TotalCharCount}" FontWeight="Bold" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Characters" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="RTL Mode Active (الكتابة من اليمين إلى اليسار)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER: PROGRESS BAR & STATUS LABEL -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                    <ProgressBar Height="6" 
                                 Value="{Binding ProgressPercentage}" 
                                 Maximum="100" 
                                 IsIndeterminate="{Binding IsIndeterminateProgress}"/>
                </StackPanel>

                <!-- Status Percentage Badge -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                           VerticalAlignment="Center" 
                           FontWeight="Bold" 
                           Margin="16,0" 
                           Visibility="{Binding IsProcessing, Converter={StaticResource NullToVisConverter}}"/>

                <!-- Cancel Operation Button -->
                <Button Grid.Column="2" 
                        Command="{Binding CancelOcrCommand}" 
                        VerticalAlignment="Center"
                        Padding="10,4"
                        Visibility="{Binding IsProcessing, Converter={StaticResource NullToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
